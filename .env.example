# ==============================================================================
# Enterprise Hybrid RAG - Environment Configuration Example
# ==============================================================================

# Option A: Groq (Ultra-fast LLM inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Option B: OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here

# (Optional) Anthropic
ANTHROPIC_API_KEY=

# Model Selection
# Groq: llama-3.1-8b-instant, llama-3.3-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
# OpenAI: gpt-4o, gpt-4o-mini
LLM_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Qdrant Vector Store Settings
QDRANT_PERSIST_DIR=./data/qdrant_db
QDRANT_COLLECTION_NAME=internal_docs
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# BM25 Lexical Store
BM25_INDEX_PATH=./data/bm25_index.pkl

# Ingestion & Chunking Defaults
DEFAULT_CHUNKING_STRATEGY=structure_aware
FIXED_CHUNK_SIZE=512
FIXED_CHUNK_OVERLAP=64
SIMILARITY_DEDUP_THRESHOLD=0.95

# Hybrid Search & Reranking Settings
DENSE_TOP_K=15
SPARSE_TOP_K=15
FUSED_TOP_K=20
FINAL_RERANK_TOP_K=5
DENSE_WEIGHT=0.70
SPARSE_WEIGHT=0.30
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation & Verification Thresholds
CONFIDENCE_THRESHOLD=0.60
VERIFY_CITATIONS=true

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ANGULAR_PORT=4200
